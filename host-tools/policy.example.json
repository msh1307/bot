{
  "workspace": "/var/lib/evo-bot/workspace",
  "runtime": "/run/evo-host",
  "users": [
    "evo-bot",
    "root"
  ],
  "max_timeout": 120,
  "approval_ttl": 330,
  "private_paths": [
    "/etc/evo-bot",
    "/run/evo-bot",
    "/var/lib/evo-bot/memory",
    "/var/lib/evo-bot/browser",
    "/var/lib/evo-bot/jobs.json",
    "/var/lib/evo-bot/ignored_channels.json",
    "/var/lib/evo-bot/evo-access-panel.json",
    "/opt/evo-bot",
    "/run/evo-web-python",
    "/etc/evo-host",
    "/run/evo-host",
    "/run/evo-access",
    "/run/evo-python",
    "/etc/evo-access",
    "/var/lib/evo-access",
    "/root",
    "/home/your-user/.ssh",
    "/home/your-user/.config",
    "/home/your-user/mshsrv",
    "/var/lib/evo-bot/mshsrv",
    "/tmp/mshsrv",
    "/home/your-user/evo-llm/backups",
    "/var/backups/evo-host"
  ]
}
