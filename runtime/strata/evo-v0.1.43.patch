+bool FileExpertSource::begin_startup_direct(std::string& why) {
+#if defined(__linux__)
+    if (base_ == nullptr || paths_.empty()) {
+        why = "no expert files open";
+        return false;
+    }
+    if (!direct_.empty()) {
+        why = "already unbuffered";
+        return false;  // do not take ownership of another mode's file handles
+    }
+    why = "startup-only O_DIRECT; mapped serving restored after resident fill";
+    return open_direct(why);
+#else
+    why = "startup-only direct read is Linux-only";
+    return false;
+#endif
+}
+
+void FileExpertSource::end_startup_direct() {
+    // The profile-fill future and every complement-copy worker have joined at the call site.
+    for (void* file : direct_) close_direct(file);
+    direct_.clear();
+}
