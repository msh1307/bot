+// A lossless bit encoding, not a quantizer. A 64-value block has a 4-byte
+// exponent base, 64 sign/mantissa bytes and 32 exponent-delta bytes. Blocks
+// spanning more than 16 exponents retain all original bits in the fallback.
+struct HcLossless {
+    std::vector<uint8_t> packed;
+    std::vector<uint16_t> fallback;
+    explicit HcLossless(const std::vector<uint16_t>& src) {
+        if (src.empty() || src.size() % 64) throw std::runtime_error("HC lossless: incomplete block");
+        packed.resize(src.size() / 64 * 100);
+        for (size_t b = 0; b < src.size() / 64; ++b) {
+            const uint16_t* w = src.data() + b * 64;
+            uint8_t* p = packed.data() + b * 100;
+            unsigned lo = 255, hi = 0;
+            for (int j = 0; j < 64; ++j) {
+                unsigned e = (w[j] >> 7) & 255;
+                if (e < lo) lo = e;
+                if (e > hi) hi = e;
+            }
+            uint32_t header = lo;
+            if (hi - lo > 15) {
+                if (fallback.size() / 64 >= 0x80000000ULL) throw std::runtime_error("HC lossless: fallback overflow");
+                header = 0x80000000U | static_cast<uint32_t>(fallback.size() / 64);
+                fallback.insert(fallback.end(), w, w + 64);
+            } else {
+                for (int j = 0; j < 64; ++j) {
+                    p[4 + j] = (w[j] & 127) | ((w[j] >> 8) & 128);
+                    p[68 + j / 2] |= (((w[j] >> 7) & 255) - lo) << (4 * (j % 2));
+                }
+            }
+            std::memcpy(p, &header, 4);
+        }
+    }
+    uint16_t at(size_t i) const {
+        const uint8_t* p = packed.data() + (i / 64) * 100;
+        uint32_t h;
+        std::memcpy(&h, p, 4);
+        const size_t j = i % 64;
+        if (h & 0x80000000U) return fallback[(h & 0x7fffffffU) * 64ULL + j];
+        return (p[4 + j] & 127) | ((p[4 + j] & 128) << 8) |
+               ((h + ((p[68 + j / 2] >> (4 * (j % 2))) & 15)) << 7);
+    }
+};
