diff --git a/include/strata/core/host_wait.hpp b/include/strata/core/host_wait.hpp
new file mode 100644
index 0000000..3c9462c
--- /dev/null
+++ b/include/strata/core/host_wait.hpp
@@ -0,0 +1,83 @@
+// Opt-in host/GPU handshake backoff. Linux only; unset/0 retains busy polling.
+#pragma once
+
+#include <chrono>
+#include <cstdlib>
+#include <thread>
+#if defined(__linux__)
+#include <sys/prctl.h>
+#endif
+
+namespace strata::core {
+namespace host_wait_detail {
+struct Config {
+    long sleep_us = 0;
+    long spin_us = 10;
+};
+inline long read_us(const char* name, long fallback) {
+    const char* value = std::getenv(name);
+    if (value == nullptr || *value == '\0') return fallback;
+    char* end = nullptr;
+    const long n = std::strtol(value, &end, 10);
+    return end != value && *end == '\0' && n >= 0 && n <= 1000 ? n : fallback;
+}
+inline const Config& config() {
+    static const Config value = [] {
+        Config c;
+#if defined(__linux__)
+        c.sleep_us = read_us("STRATA_HOST_WAIT_US", 0);
+        c.spin_us = read_us("STRATA_HOST_SPIN_US", 10);
+#endif
+        return c;
+    }();
+    return value;
+}
+}  // namespace host_wait_detail
+
+inline bool host_wait_enabled() { return host_wait_detail::config().sleep_us > 0; }
+
+// Linux normally coalesces short sleeps with a 50us timer slack. Tighten it only
+// for this calling thread while backoff is enabled, then restore its prior value.
+class HostWaitTimerSlack {
+public:
+    HostWaitTimerSlack() {
+#if defined(__linux__)
+        if (!host_wait_enabled()) return;
+        const long previous = ::prctl(PR_GET_TIMERSLACK, 0UL, 0UL, 0UL, 0UL);
+        if (previous > 1 && ::prctl(PR_SET_TIMERSLACK, 1UL, 0UL, 0UL, 0UL) == 0)
+            previous_ = previous;
+#endif
+    }
+    ~HostWaitTimerSlack() {
+#if defined(__linux__)
+        if (previous_ > 0)
+            (void) ::prctl(PR_SET_TIMERSLACK, (unsigned long) previous_, 0UL, 0UL, 0UL);
+#endif
+    }
+    HostWaitTimerSlack(const HostWaitTimerSlack&) = delete;
+    HostWaitTimerSlack& operator=(const HostWaitTimerSlack&) = delete;
+private:
+    long previous_ = -1;
+};
+
+class HostWait {
+public:
+    using Clock = std::chrono::steady_clock;
+    HostWait() {
+        if (host_wait_enabled())
+            next_sleep_ = Clock::now() +
+                          std::chrono::microseconds(host_wait_detail::config().spin_us);
+    }
+    // Call only after the existing driver/error checks and while the GPU's
+    // completion word is still pending. No whole-stream wait: the GPU may be
+    // waiting for a flag that this same host loop must publish.
+    void poll(Clock::time_point now) {
+        const auto& cfg = host_wait_detail::config();
+        if (cfg.sleep_us == 0 || now < next_sleep_) return;
+        std::this_thread::sleep_for(std::chrono::microseconds(cfg.sleep_us));
+        next_sleep_ = Clock::now() + std::chrono::microseconds(cfg.spin_us);
+    }
+private:
+    Clock::time_point next_sleep_{};
+};
+}  // namespace strata::core
