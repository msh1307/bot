@@ -0,0 +1,16 @@
+#pragma once
+
+#include <bit>
+#include <cstdint>
+#include <stdexcept>
+
+namespace gufo::models::qwen::vision::detail {
+inline std::uint16_t LosslessF16ToBf16(std::uint16_t bits) {
+  const float value = static_cast<float>(std::bit_cast<_Float16>(bits));
+  const auto wide = std::bit_cast<std::uint32_t>(value);
+  if ((wide & 0xffffu) != 0 || (wide & 0x7f800000u) == 0x7f800000u) {
+    throw std::invalid_argument("F16 vision weight is not finite exact BF16");
+  }
+  return static_cast<std::uint16_t>(wide >> 16);
+}
+}  // namespace gufo::models::qwen::vision::detail
