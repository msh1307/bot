 SHELL_TOOL = 'shell_exec'
+MODEL_OUTPUT_BYTES = 8192
+
+
+def compact_output(text):
+    data = text.encode('utf-8')
+    if len(data) <= MODEL_OUTPUT_BYTES:
+        return text
+    head = data[:4096].decode('utf-8', 'ignore')
+    tail = data[-3072:].decode('utf-8', 'ignore')
+    return (head + '\n[... middle omitted from ' + str(len(data))
+            + ' output bytes; rerun with narrower output if needed ...]\n' + tail)
 
 
