[Unit]
Description=EVO owner Discord assistant using Pi
Wants=network-online.target
After=network-online.target evo-host.service evo-router.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=evo-bot
Group=evo-bot
Environment=HOME=/var/lib/evo-bot
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Seoul
EnvironmentFile=/etc/evo-bot/discord.env
WorkingDirectory=/opt/evo-bot
ExecStart=/opt/evo-bot/venv/bin/python -m evo_bot.gateway
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
KillMode=control-group
UMask=0077
RuntimeDirectory=evo-bot evo-bot/profiles
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/evo-bot /var/lib/evo-bot/workspace /run/evo-bot
PrivateTmp=true
ProtectKernelTunables=false
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
MemoryHigh=1536M
MemoryMax=2G
MemorySwapMax=0
CPUQuota=200%
TasksMax=1024
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
