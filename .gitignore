# This workspace also contains private infrastructure notes and experiments.
# Track the bot, its host broker and the curated inference patches.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/omp-migration/
!/host-tools/
!/runtime/
/runtime/**
!/runtime/**/
!/runtime/README.md
!/runtime/THIRD-PARTY-NOTICES.md
!/runtime/manifest.json
!/runtime/strata/*.patch
!/runtime/vision/*.patch
/omp-migration/*
!/omp-migration/evo_omp/
!/omp-migration/*.py
!/omp-migration/*.service
!/omp-migration/config.yml
!/omp-migration/models.yml
!/omp-migration/instructions.txt
!/omp-migration/requirements.txt
!/omp-migration/provider.ts
!/omp-migration/README.md
/omp-migration/evo_omp/**
!/omp-migration/evo_omp/**/
!/omp-migration/evo_omp/**/*.py
/host-tools/*
!/host-tools/evo-host-broker.py
!/host-tools/command-runner.py
!/host-tools/evo-host.service
!/host-tools/policy.example.json
!/host-tools/README.md

__pycache__/
*.py[cod]

