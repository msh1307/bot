+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+import type { AgentMessage } from "@oh-my-pi/pi-agent-core";
+import {
+	DEFAULT_COMPACTION_SETTINGS,
+	prepareCompaction,
+	projectEvoCompletedReasoning,
+	type SessionMessageEntry,
+} from "@oh-my-pi/pi-agent-core/compaction";
+import { getBundledModel } from "@oh-my-pi/pi-catalog/models";
+import { createAssistantMessage, createUserMessage } from "./helpers";
+
+const model = {
+	...getBundledModel("anthropic", "claude-sonnet-4-5")!,
+	provider: "evo",
+	api: "openai-completions" as const,
+	id: "sc117-flash-next-iq3_xxs",
+	tokenizer: "qwen3" as const,
+};
+const thought = { type: "thinking" as const, thinking: "OLD_THOUGHT ".repeat(200) };
+const text = { type: "text" as const, text: "SOURCE_EVIDENCE ".repeat(200) };
+let prior: string | undefined;
+beforeEach(() => {
+	prior = process.env.EVO_COMPLETED_REASONING_CONTEXT;
+	process.env.EVO_COMPLETED_REASONING_CONTEXT = "1";
+});
+afterEach(() => {
+	if (prior === undefined) delete process.env.EVO_COMPLETED_REASONING_CONTEXT;
+	else process.env.EVO_COMPLETED_REASONING_CONTEXT = prior;
+});
+
+describe("EVO completed reasoning accounting", () => {
+	test("keeps original history, user instructions, tools, attachments and current thinking", () => {
+		const call = { type: "toolCall" as const, id: "c1", name: "read", arguments: { path: "source" } };
+		const tool: AgentMessage = {
+			role: "toolResult",
+			toolCallId: "c1",
+			toolName: "read",
+			content: [text],
+			isError: false,
+			timestamp: 2,
+		};
+		const messages: AgentMessage[] = [
+			createUserMessage("Read only"),
+			createAssistantMessage([thought, call], "toolUse"),
+			tool,
+			createAssistantMessage([thought, text]),
+			{ role: "user", content: [{ type: "image", data: "fixture", mimeType: "image/png" }], timestamp: 3 },
+			createAssistantMessage([thought, call], "toolUse"),
+		];
+		const original = JSON.stringify(messages);
+		const projected = projectEvoCompletedReasoning(messages, model);
+		expect(JSON.stringify(messages)).toBe(original);
+		if (projected[1].role !== "assistant") throw new Error("Lost assistant");
+		expect(projected[1].content).toEqual([call]);
+		if (projected[3].role !== "assistant") throw new Error("Lost assistant");
+		expect(projected[3].content).toEqual([text]);
+		for (const i of [0, 2, 4, 5]) expect(projected[i]).toBe(messages[i]);
+		expect(projectEvoCompletedReasoning(projected, model)).toEqual(projected);
+	});
+	test.each(["toolUse", "length", "aborted", "error"] as const)("retains unfinished %s reasoning", reason => {
+		const messages = [
+			createUserMessage("task"),
+			createAssistantMessage([thought, text], reason),
+			createUserMessage("correction"),
+		];
+		expect(projectEvoCompletedReasoning(messages, model)).toBe(messages);
+	});
+	test("requires opt-in and an EVO provider", () => {
+		const messages = [createUserMessage("task"), createAssistantMessage([thought, text]), createUserMessage("next")];
+		expect(projectEvoCompletedReasoning(messages, { provider: "other" })).toBe(messages);
+		delete process.env.EVO_COMPLETED_REASONING_CONTEXT;
+		expect(projectEvoCompletedReasoning(messages, model)).toBe(messages);
+	});
+	test("compaction cuts and summarizes the projected view but preserves IDs and original messages", () => {
+		const messages = [
+			createUserMessage("OWNER_INTENT"),
+			createAssistantMessage([thought, text]),
+			createUserMessage("OWNER_CORRECTION"),
+			createAssistantMessage([{ type: "thinking" as const, thinking: "CURRENT_THOUGHT" }, text], "toolUse"),
+		];
+		const entries: SessionMessageEntry[] = messages.map((message, i) => ({
+			type: "message",
+			message,
+			id: `e${i}`,
+			parentId: null,
+			timestamp: new Date(i).toISOString(),
+		}));
+		const original = JSON.stringify(entries);
+		const prep = prepareCompaction(entries, { ...DEFAULT_COMPACTION_SETTINGS, keepRecentTokens: 100 }, model)!;
+		expect(prep).toBeDefined();
+		const rendered = JSON.stringify([
+			...prep.messagesToSummarize,
+			...prep.turnPrefixMessages,
+			...prep.recentMessages,
+		]);
+		expect(rendered).not.toContain("OLD_THOUGHT");
+		for (const value of ["OWNER_INTENT", "OWNER_CORRECTION", "SOURCE_EVIDENCE", "CURRENT_THOUGHT"])
+			expect(rendered).toContain(value);
+		expect(entries.some(e => e.id === prep.firstKeptEntryId)).toBe(true);
+		expect(JSON.stringify(entries)).toBe(original);
+	});
+});
