+import type { Model } from "@oh-my-pi/pi-ai";
+import type { AgentMessage } from "../types";
+
+/** Match EVO's request projection without rewriting its RAM transcript.
+ * Only completed earlier user turns lose thinking. Current/unfinished turns
+ * keep it, including while summarizing. Other providers and default builds
+ * retain the upstream accounting contract.
+ */
+export function projectEvoCompletedReasoning(
+	messages: AgentMessage[],
+	model?: Pick<Model, "provider">,
+): AgentMessage[] {
+	if (process.env.EVO_COMPLETED_REASONING_CONTEXT !== "1" || model?.provider !== "evo") return messages;
+	const remove = new Set<number>();
+	let start = -1;
+	for (let end = 0; end < messages.length; end++) {
+		if (messages[end].role !== "user") continue;
+		if (start >= 0) {
+			const last = messages.slice(start + 1, end).findLast(message => message.role === "assistant");
+			if (last?.role === "assistant" && last.stopReason === "stop") {
+				for (let i = start + 1; i < end; i++) {
+					if (messages[i].role === "assistant") remove.add(i);
+				}
+			}
+		}
+		start = end;
+	}
+	if (!remove.size) return messages;
+	return messages.map((message, i) =>
+		remove.has(i) && message.role === "assistant"
+			? { ...message, content: message.content.filter(block => block.type !== "thinking") }
+			: message,
+	);
+}
