@@ -0,0 +1,30 @@
+import { describe, expect, it } from "bun:test";
+import { Settings } from "../src/config/settings";
+import type { ToolSession } from "../src/tools";
+import { GrepTool } from "../src/tools/grep";
+
+function session(active?: (name: string) => boolean): ToolSession {
+	return { cwd: "/tmp", settings: Settings.isolated(), isToolActive: active } as ToolSession;
+}
+
+describe("grep delegation availability", () => {
+	it("does not require a task tool absent from the active inventory", () => {
+		const tool = new GrepTool(session(() => false));
+		expect(tool.description).not.toContain("Task");
+		expect(tool.description).not.toContain("scout");
+		expect(tool.description).toContain("skip");
+	});
+	it("keeps existing behavior when task is active or inventory is unknown", () => {
+		expect(new GrepTool(session(name => name === "task")).description).toContain("Task + scout");
+		expect(new GrepTool(session()).description).toContain("Task + scout");
+	});
+	it("refreshes its cached description when task availability changes", () => {
+		let active = false;
+		const tool = new GrepTool(session(name => active && name === "task"));
+		expect(tool.description).not.toContain("Task");
+		active = true;
+		expect(tool.description).toContain("Task + scout");
+		active = false;
+		expect(tool.description).not.toContain("Task");
+	});
+});
