+/** Keep a small, exact source trail outside the model-written summary. */
+function renderUserRequests(requests: { id: string; text: string }[], tokenizer: Tokenizer, budget: number): string {
+	const excerpts = requests.map(request => {
+		const points = Array.from(request.text);
+		let keep = Math.min(points.length, 2048);
+		let text = request.text;
+		while (!tokenizer.checkTokenBudget(text, 256).fits) {
+			keep = Math.floor(keep / 2);
+			text = `${points.slice(0, keep).join("")} […excerpt; middle omitted…] ${points.slice(-keep).join("")}`;
+			if (keep === 0) {
+				text = "[excerpt omitted; token budget]";
+				break;
+			}
+		}
+		return { id: request.id, text, truncated: text !== request.text };
+	});
+	while (excerpts.length > 0) {
+		// Escape markup in JSON values so pasted user text cannot close this boundary.
+		const requests = JSON.stringify(excerpts).replace(/</g, "\\u003c").replace(/>/g, "\\u003e");
+		const rendered = prompt.render(compactionUserRequestsPrompt, { requests });
+		if (tokenizer.checkTokenBudget(rendered, budget).fits) return rendered;
+		excerpts.shift();
+	}
