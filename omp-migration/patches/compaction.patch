+/** Essential summaries must finish before they can replace conversation history. */
+function requireSummaryText(prefix: string, response: AssistantMessage): string {
+	if (response.stopReason === "error") throw createSummarizationError(prefix, response);
+	if (response.stopReason !== "stop") {
+		throw new Error(`${prefix}: incomplete response (${response.stopReason})`);
+	}
+	const text = response.content
+		.filter((c): c is { type: "text"; text: string } => c.type === "text")
+		.map(c => c.text)
+		.join("\n");
+	if (!text.trim()) throw new Error(`${prefix}: empty summary`);
+	return text;
+}
