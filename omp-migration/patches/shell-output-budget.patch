+}
+
+/** Streaming tools retain the configured head/tail budget, capped by the spill threshold. */
+export function resolveOutputSinkInlineBytes(s: Settings | undefined): number {
+	const { threshold, headBytes, tailBytes } = getSpillConfig(s);
+	return Math.max(1, Math.min(threshold, headBytes + tailBytes));
 }
 
